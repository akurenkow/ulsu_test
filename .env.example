# ============================================================================
# Smart Logistics Data & ML Platform — шаблон конфигурации.
# Скопируйте в `.env` и при необходимости измените значения:
#   cp .env.example .env
# `.env` добавлен в `.gitignore` и не публикуется.
#
# Все значения ниже — локальные dev-дефолты (НЕ для production).
# Пароли задаются только через переменные окружения, в коде не хранятся.
# ============================================================================

# --- PostgreSQL (контейнер) и операционная БД-источник ---------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres              # dev-only, смените для общих окружений
POSTGRES_DB=deals_bigdata               # операционный источник (схема public)
POSTGRES_HOST_PORT=5432                 # порт на хосте -> 5432 в контейнере

# --- Хранилище (DWH) --------------------------------------------------------
DWH_DB=dwh                              # БД хранилища (схемы: raw, core, mart)
DWH_USER=dwh_user                       # прикладная роль для ETL/ML
DWH_PASSWORD=dwh_password                # dev-only, смените для общих окружений

# --- Генерация синтетического источника ------------------------------------
N_PRICES=300000                         # число сделок в synthetic.sql
RANDOM_SEED=0.20261026                  # фиксированное зерно synthetic.sql (справочно)
AS_OF=2026-10-26                        # дата снимка данных

# --- ML ----------------------------------------------------------------------
ML_RANDOM_SEED=42                       # зерно для воспроизводимости моделей
# поиск параметров через grid search: docker compose --profile ml run --rm ml python -m ml.tune --as-of 2026-10-26
ML_POINT_LOSS=log_rmse                  # лосс точечной модели: log_rmse (рекомендован для MAPE) | RMSE (бейзлайн) | MAPE (нативный)
ML_DEPTH=4                              # глубина деревьев CatBoost (None -> дефолт 6)
ML_L2_LEAF_REG=3.0                      # L2-регуляризация листьев (None -> дефолт 3.0)
ML_LEARNING_RATE=0.03                   # скорость обучения (None -> дефолт 0.03)
# ML_MODEL_PATH=/app/ml/artifacts/catboost.cbm   # путь к артефакту модели (по умолчанию)

# --- Логирование -------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# --- Параметры подключения приложений (etl/ml) ------------------------------
# Внутри docker-compose хост переопределяется на имя сервиса `postgres`;
# при локальном запуске Python-кода вне Docker используйте localhost.
DB_HOST=localhost
DB_PORT=5432

# --- API демо-дашборда «Рынок ставок» (FastAPI) ------------------------------
API_HOST_PORT=8000                      # порт на хосте -> 8000 в контейнере

# ============================================================================
# Бонус ★: Apache Airflow (профиль `airflow`).
#   docker compose --profile airflow up -d   # UI: http://localhost:8080
# БД метаданных Airflow отделена от deals_bigdata/dwh (сервис postgres-airflow).
# ============================================================================
AIRFLOW_WWW_PORT=8080
AIRFLOW_UID=50000                          # uid пользователя airflow в контейнере
AIRFLOW_ADMIN_USER=airflow                 # админ UI Airflow
AIRFLOW_ADMIN_PASSWORD=airflow             # dev-only, смените для общих окружений
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_POSTGRES_USER=airflow              # роль БД метаданных Airflow
AIRFLOW_POSTGRES_PASSWORD=airflow          # dev-only
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_FERNET_KEY=VrmpiH-KqsJGYLbddvb_0_OPC2XUwpMWU4VkzKYgvI8=   # dev-only (шифрование connections)
AIRFLOW_WEBSERVER_SECRET_KEY=_HoTiqYe10IsBZnR0qVhQHfFNqEElW5ErsELFBJvmGs  # dev-only

# ============================================================================
# Бонус ★: Apache Superset (профиль `superset`).
#   docker compose --profile superset up -d   # UI: http://localhost:8088
# ============================================================================
SUPERSET_HOST_PORT=8088
SUPERSET_SECRET_KEY=_HoTiqYe10IsBZnR0qVhQHfFNqEElW5ErsELFBJvmGs  # dev-only
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin              # dev-only
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com
# Подключение Superset к DWH формируется в docker-compose из DWH_*/DB_HOST.

# ============================================================================
# Бонус ★: ClickHouse (профиль `clickhouse`).
#   docker compose --profile clickhouse up -d  # HTTP: http://localhost:8123
# ============================================================================
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=dwh                         # БД аналитического слоя в ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse            # dev-only
