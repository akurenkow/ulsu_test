# ETL application image (Python 3.11).
# Запускает пайплайн извлечения/очистки/загрузки в Core DWH (этап 2).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt requirements-clickhouse.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir -r requirements-clickhouse.txt

COPY common/ ./common/
COPY etl/ ./etl/
COPY clickhouse/ ./clickhouse/
COPY sql/ ./sql/

CMD ["python", "-m", "etl.main"]
